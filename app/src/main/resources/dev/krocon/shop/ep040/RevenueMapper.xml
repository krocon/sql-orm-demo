<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.krocon.shop.ep040.RevenueMapper">

  <!-- Records haben keinen Default-Konstruktor → Mapping über den Konstruktor -->
  <resultMap id="statusRevenue" type="dev.krocon.shop.ep040.StatusRevenue">
    <constructor>
      <arg column="status" javaType="dev.krocon.shop.domain.OrderStatus"/>
      <arg column="revenue" javaType="java.math.BigDecimal"/>
    </constructor>
  </resultMap>

  <select id="revenueByStatus" resultMap="statusRevenue">
    SELECT status, sum(total) AS revenue
    FROM orders
    GROUP BY status
  </select>
</mapper>
